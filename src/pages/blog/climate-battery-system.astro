---
import BlogLayout from "../../layouts/BlogLayout.astro";
---

<BlogLayout
  title="The Climate Battery — Turgor"
  description="Underground thermal storage for a 4x5m greenhouse. Interactive 3D simulation included."
  canonicalPath="/blog/climate-battery-system"
>
  <article class="mx-auto max-w-2xl px-6 pt-12 md:pt-20">
    <header class="mb-12">
      <nav class="flex items-center gap-2 text-xs font-bold tracking-[0.15em] uppercase text-[var(--color-blog-accent)] mb-6">
        <a href="/" class="hover:text-[var(--color-blog-accent-light)] transition-colors duration-300">Turgor</a>
        <span class="text-[var(--color-blog-muted)]">/</span>
        <a href="/blog" class="hover:text-[var(--color-blog-accent-light)] transition-colors duration-300">Blog</a>
      </nav>
      <h1
        class="font-black tracking-tight leading-none"
        style="font-size: clamp(2rem, 5vw, 3.5rem);"
      >
        The Climate Battery
      </h1>
      <time
        datetime="2026-03-09"
        class="block mt-4 text-xs font-bold tracking-[0.15em] uppercase text-[var(--color-blog-muted)]"
      >
        March 9, 2026
      </time>
    </header>

    <div class="prose-section space-y-8 text-sm leading-relaxed text-[var(--color-blog-text)]">
      <section>
        <h2 class="text-base font-black text-[var(--color-blog-accent)] mb-3">The Problem</h2>
        <p>
          Greenhouses trap sunlight during the day. They get hot — sometimes too hot.
          But the moment the sun sets, all that heat escapes through the glass. By morning,
          the temperature inside can be barely above freezing. You either burn propane,
          run electric heaters, or accept dead seedlings after the first hard frost.
        </p>
      </section>

      <section>
        <h2 class="text-base font-black text-[var(--color-blog-accent)] mb-3">The Idea</h2>
        <p>
          A climate battery stores daytime heat underground and releases it at night.
          The concept is simple: blow warm greenhouse air through pipes buried in the soil.
          The soil absorbs the heat. When temperatures drop, the thermal mass radiates warmth
          back up. No fuel, no grid power, no moving parts beyond a single fan.
        </p>
      </section>

      <section>
        <h2 class="text-base font-black text-[var(--color-blog-accent)] mb-3">How It Works</h2>
        <p>
          During the day, a thermostat-controlled fan pulls warm air from the greenhouse peak
          down through a vertical riser into a network of buried corrugated pipes. As air
          travels through the pipes, it transfers heat to the surrounding soil. The cooled air
          returns through a second riser on the opposite end. At night, the process reverses —
          the warm soil heats the cool air passing through.
        </p>
      </section>

      <section>
        <h2 class="text-base font-black text-[var(--color-blog-accent)] mb-3">Our Design</h2>
        <p>
          We designed this for a 4 × 5 meter greenhouse. Eight 110mm corrugated drainage pipes
          run the full length in two layers — four at 80cm depth, four at 120cm. A 12V inline fan
          mounted in the north riser moves air at roughly 100–150 m³/h. The whole system runs off
          a 50W solar panel and a small battery. No grid connection.
        </p>
      </section>
    </div>
  </article>

  <!-- ═══════════════════════════════════════ SIMULATOR EMBED -->
  <section class="my-12 md:my-20">
    <div class="max-w-[90vw] mx-auto rounded-lg overflow-hidden border border-[var(--color-blog-border)]"
         style="height: 70vh;">
      <div id="app" class="flex flex-col h-full">

        <main class="flex flex-col lg:flex-row flex-1 min-h-0">

          <!-- 3D Viewport -->
          <div id="viewport" class="relative lg:w-[65%] h-[60%] lg:h-auto shrink-0">
            <canvas id="canvas"></canvas>
            <div id="webgl-fallback" class="hidden absolute inset-0 flex items-center justify-center p-8"
                 style="background-color: var(--color-blog-bg);">
              <p class="text-center max-w-md" style="color: var(--color-blog-muted);">
                WebGL is not supported in your browser. Please use a modern browser to view the 3D simulation.
              </p>
            </div>
            <div id="labels-container" class="absolute inset-0 pointer-events-none overflow-hidden"></div>
            <div id="compass" class="absolute top-3 right-3 pointer-events-none" style="width:56px;height:56px;">
              <div id="compass-ring" style="width:100%;height:100%;position:relative;">
                <svg viewBox="0 0 56 56" style="width:100%;height:100%;">
                  <circle cx="28" cy="28" r="26" fill="rgba(0,0,0,0.35)" stroke="rgba(255,255,255,0.25)" stroke-width="1"/>
                </svg>
                <span class="compass-dir" style="top:2px;left:50%;transform:translateX(-50%);" id="compass-n">N</span>
                <span class="compass-dir" style="bottom:2px;left:50%;transform:translateX(-50%);" id="compass-s">S</span>
                <span class="compass-dir" style="left:3px;top:50%;transform:translateY(-50%);" id="compass-w">W</span>
                <span class="compass-dir" style="right:3px;top:50%;transform:translateY(-50%);" id="compass-e">E</span>
              </div>
            </div>
          </div>

          <!-- Info Panel -->
          <aside id="info-panel" class="lg:w-[35%] flex-1 min-h-0 overflow-y-auto p-4 md:p-6 border-t lg:border-t-0 lg:border-l flex flex-col gap-4"
                 style="border-color: color-mix(in srgb, var(--color-blog-muted) 20%, transparent);">

            <!-- System Overview -->
            <div class="panel-card rounded-lg p-4" style="background: color-mix(in srgb, var(--color-blog-muted) 8%, transparent);">
              <h3 class="text-xs font-bold tracking-[0.15em] uppercase mb-3" style="color: var(--color-blog-muted);">System Overview</h3>
              <p class="text-sm leading-relaxed">
                4 &times; 5 m greenhouse. 8 &times; 110 mm corrugated pipes in 2 layers at 80 cm and 120 cm depth. 12V solar-powered inline fan. Passive thermal storage in soil mass.
              </p>
            </div>

            <!-- Mode Display -->
            <div id="mode-card" class="panel-card rounded-lg p-4" style="background: color-mix(in srgb, var(--color-blog-muted) 8%, transparent);">
              <h3 id="mode-title" class="text-base font-black mb-3">Storing Heat</h3>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <span class="block text-xs font-bold uppercase tracking-wide" style="color: var(--color-blog-muted);">Outside</span>
                  <span id="temp-outside" class="text-xl font-black tabular-nums">-5°C</span>
                </div>
                <div>
                  <span class="block text-xs font-bold uppercase tracking-wide" style="color: var(--color-blog-muted);">Greenhouse</span>
                  <span id="temp-greenhouse" class="text-xl font-black tabular-nums" style="color: #F59E0B;">30°C</span>
                </div>
                <div>
                  <span class="block text-xs font-bold uppercase tracking-wide" style="color: var(--color-blog-muted);">Soil Temp</span>
                  <span id="temp-soil" class="text-xl font-black tabular-nums" style="color: #EF4444;">20°C</span>
                </div>
                <div>
                  <span class="block text-xs font-bold uppercase tracking-wide" style="color: var(--color-blog-muted);">Fan</span>
                  <span id="fan-status" class="text-xl font-black">ON</span>
                </div>
              </div>
            </div>

            <!-- Time Display -->
            <div class="panel-card rounded-lg p-4" style="background: color-mix(in srgb, var(--color-blog-muted) 8%, transparent);">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold tracking-[0.15em] uppercase" style="color: var(--color-blog-muted);">Time</span>
                <span id="time-display" class="text-2xl font-black tabular-nums">12:00</span>
              </div>
            </div>

            <!-- Component Details -->
            <div class="flex flex-col gap-2">
              <h3 class="text-xs font-bold tracking-[0.15em] uppercase mt-2" style="color: var(--color-blog-muted);">Components</h3>

              <details id="detail-pipes" class="panel-card rounded-lg" style="background: color-mix(in srgb, var(--color-blog-muted) 8%, transparent);">
                <summary class="p-3 text-sm font-bold cursor-pointer hover:opacity-70 transition-opacity">Pipes</summary>
                <div class="px-3 pb-3 text-sm leading-relaxed" style="color: var(--color-blog-muted);">
                  110 mm corrugated drainage pipe. 8 runs in 2 layers (4 per layer). 50 cm spacing, 50 cm from walls. ~40 m total length. Dark gray, UV-resistant.
                </div>
              </details>

              <details id="detail-manifold" class="panel-card rounded-lg" style="background: color-mix(in srgb, var(--color-blog-muted) 8%, transparent);">
                <summary class="p-3 text-sm font-bold cursor-pointer hover:opacity-70 transition-opacity">Manifolds</summary>
                <div class="px-3 pb-3 text-sm leading-relaxed" style="color: var(--color-blog-muted);">
                  160 mm PVC or plywood box 40 &times; 60 &times; 30 cm. One at each end (north and south). Connects all pipe runs to vertical risers.
                </div>
              </details>

              <details id="detail-fan" class="panel-card rounded-lg" style="background: color-mix(in srgb, var(--color-blog-muted) 8%, transparent);">
                <summary class="p-3 text-sm font-bold cursor-pointer hover:opacity-70 transition-opacity">Fan</summary>
                <div class="px-3 pb-3 text-sm leading-relaxed" style="color: var(--color-blog-muted);">
                  12V inline duct fan. 100–150 m³/h. Gentle airflow is critical — too fast and heat does not transfer to soil. Mounted in Riser A (north).
                </div>
              </details>

              <details id="detail-risers" class="panel-card rounded-lg" style="background: color-mix(in srgb, var(--color-blog-muted) 8%, transparent);">
                <summary class="p-3 text-sm font-bold cursor-pointer hover:opacity-70 transition-opacity">Risers</summary>
                <div class="px-3 pb-3 text-sm leading-relaxed" style="color: var(--color-blog-muted);">
                  110 mm PVC vertical pipes. One per end. Riser A (north) has inline fan. Riser B (south) is open passive return.
                </div>
              </details>
            </div>

          </aside>
        </main>

        <!-- ═══════════════════════════════════════ BOTTOM CONTROLS -->
        <footer class="flex flex-wrap items-center gap-2 px-4 md:px-6 py-2 shrink-0 border-t"
                style="border-color: color-mix(in srgb, var(--color-blog-muted) 20%, transparent);">
          <div class="flex items-center gap-1 rounded-lg p-1" style="background: color-mix(in srgb, var(--color-blog-muted) 12%, transparent);">
            <button id="btn-day" class="mode-btn active px-3 py-1.5 rounded-md text-xs font-bold tracking-wide transition-all" aria-label="Day mode">
              Day
            </button>
            <button id="btn-night" class="mode-btn px-3 py-1.5 rounded-md text-xs font-bold tracking-wide transition-all" aria-label="Night mode">
              Night
            </button>
          </div>
          <label class="flex items-center gap-2 flex-1 min-w-0">
            <span class="text-xs font-bold tracking-wide uppercase shrink-0 hidden sm:inline" style="color: var(--color-blog-muted);">Time</span>
            <input id="time-slider" type="range" min="0" max="1440" value="720" step="1"
                   class="flex-1 h-1.5 rounded-full appearance-none cursor-pointer"
                   style="accent-color: var(--color-blog-accent);" />
          </label>
          <div class="flex items-center gap-1.5">
            <button id="btn-cutaway" class="ctrl-btn active px-3 py-1.5 rounded-md text-xs font-bold tracking-wide transition-all" title="Toggle underground cutaway">
              Cutaway
            </button>
            <button id="btn-greenhouse" class="ctrl-btn active px-3 py-1.5 rounded-md text-xs font-bold tracking-wide transition-all" title="Toggle greenhouse frame">
              Frame
            </button>
            <button id="btn-labels" class="ctrl-btn px-3 py-1.5 rounded-md text-xs font-bold tracking-wide transition-all" title="Toggle 3D labels">
              Labels
            </button>
            <button id="btn-reset" class="ctrl-btn px-3 py-1.5 rounded-md text-xs font-bold tracking-wide transition-all" title="Reset camera view">
              Reset
            </button>
          </div>
        </footer>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ CLOSING CONTENT -->
  <article class="mx-auto max-w-2xl px-6 pb-12 md:pb-20">
    <div class="prose-section space-y-8 text-sm leading-relaxed text-[var(--color-blog-text)]">
      <section>
        <h2 class="text-base font-black text-[var(--color-blog-accent)] mb-3">What We Learned</h2>
        <p>
          Pipe spacing matters more than pipe count. Too close and the soil between them
          saturates quickly. Too far and you waste thermal mass. 50cm center-to-center at
          our scale hits the sweet spot.
        </p>
        <p class="mt-3">
          Airflow speed is counterintuitive — slower is better. The air needs contact time
          with the pipe walls to transfer heat. A fan that is too powerful pushes warm air
          straight through without dumping its energy.
        </p>
      </section>

      <section>
        <h2 class="text-base font-black text-[var(--color-blog-accent)] mb-3">What's Next</h2>
        <p>
          The climate battery is the first piece of Turgor — an autonomous greenhouse control
          system we are building in the open. Sensors, AI-driven decision making, and
          safety-first automation. Follow the build at turgor.garden.
        </p>
      </section>
    </div>

    <footer class="mt-16 border-t border-[var(--color-blog-border)] pt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <a
        href="/blog"
        class="text-xs font-bold tracking-[0.15em] uppercase text-[var(--color-blog-accent)]
               hover:text-[var(--color-blog-accent-light)] transition-colors duration-300"
      >
        ← Back to blog
      </a>
      <a
        href="https://ovmi.digital"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-bold tracking-[0.2em] uppercase text-[var(--color-blog-muted)]
               hover:text-[var(--color-blog-accent)] transition-colors duration-300"
      >
        An Ovmi project
      </a>
    </footer>
  </article>

  <style is:inline>
    #canvas { width: 100%; height: 100%; display: block; }

    .mode-btn {
      background: transparent;
      color: var(--color-blog-muted);
      border: none;
      cursor: pointer;
    }
    .mode-btn.active {
      background: var(--color-blog-text);
      color: var(--color-blog-bg);
    }

    .ctrl-btn {
      background: transparent;
      color: var(--color-blog-muted);
      border: 1px solid color-mix(in srgb, var(--color-blog-muted) 25%, transparent);
      cursor: pointer;
    }
    .ctrl-btn.active {
      background: var(--color-blog-text);
      color: var(--color-blog-bg);
      border-color: var(--color-blog-text);
    }
    .ctrl-btn:hover { opacity: 0.7; }

    input[type="range"] {
      background: color-mix(in srgb, var(--color-blog-muted) 25%, transparent);
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 14px; height: 14px;
      border-radius: 50%;
      background: var(--color-blog-text);
      cursor: pointer;
    }

    details summary { list-style: none; }
    details summary::-webkit-details-marker { display: none; }
    details summary::before { content: '+ '; font-weight: 900; margin-right: 0.25rem; }
    details[open] summary::before { content: '- '; }

    .compass-dir {
      position: absolute;
      font-size: 9px;
      font-weight: 900;
      letter-spacing: 0.05em;
      color: rgba(255,255,255,0.8);
      line-height: 1;
    }
    #compass-n { color: #f87171; }

    .label-3d {
      position: absolute;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
      padding: 2px 6px;
      border-radius: 3px;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }
  </style>

  <script>
    import { init } from '../../scripts/simulator/climate-battery/index.js';

    const canvas = document.getElementById('canvas');
    const viewport = document.getElementById('viewport');
    const sim = init(canvas, viewport);

    // Day/Night buttons
    document.getElementById('btn-day').addEventListener('click', () => {
      const t = sim.setMode(true);
      document.getElementById('btn-day').classList.add('active');
      document.getElementById('btn-night').classList.remove('active');
      document.getElementById('time-slider').value = t;
    });
    document.getElementById('btn-night').addEventListener('click', () => {
      const t = sim.setMode(false);
      document.getElementById('btn-night').classList.add('active');
      document.getElementById('btn-day').classList.remove('active');
      document.getElementById('time-slider').value = t;
    });

    // Time slider
    document.getElementById('time-slider').addEventListener('input', (e) => {
      const minutes = parseInt(e.target.value);
      sim.setTime(minutes);
      const isDay = sim.getIsDay();
      document.getElementById('btn-day').classList.toggle('active', isDay);
      document.getElementById('btn-night').classList.toggle('active', !isDay);
    });

    // Toggle buttons
    document.getElementById('btn-cutaway').addEventListener('click', () => {
      const active = sim.toggleCutaway();
      document.getElementById('btn-cutaway').classList.toggle('active', active);
    });
    document.getElementById('btn-greenhouse').addEventListener('click', () => {
      const active = sim.toggleGreenhouse();
      document.getElementById('btn-greenhouse').classList.toggle('active', active);
    });
    document.getElementById('btn-labels').addEventListener('click', () => {
      const active = sim.toggleLabels();
      document.getElementById('btn-labels').classList.toggle('active', active);
    });
    document.getElementById('btn-reset').addEventListener('click', () => {
      sim.resetCamera();
    });
  </script>
</BlogLayout>
